  const linhasIpl = [
    ['Nome da IPL', dados.nomeIpl],
    ['INFOPEN', infopen],
    ['Observações', observacoes],
  ];

  return `
    <!doctype html>
    <html>
      <body style="margin:0;padding:0;background:#f5f2ed;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background:#f5f2ed;">
          <tr>
            <td align="center" style="padding:28px 14px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;max-width:760px;background:#ffffff;border:1px solid #e7e2d8;border-radius:14px;overflow:hidden;">
                
                <tr>
                  <td style="padding:0;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                      <tr>
                        <td style="height:5px;background:#b42318;width:25%;font-size:0;line-height:0;">&nbsp;</td>
                        <td style="height:5px;background:#ffffff;width:50%;font-size:0;line-height:0;">&nbsp;</td>
                        <td style="height:5px;background:#1d4ed8;width:25%;font-size:0;line-height:0;">&nbsp;</td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <tr>
                  <td style="padding:26px 30px 20px 30px;border-bottom:1px solid #eee8dc;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                      <tr>
                        <td style="vertical-align:middle;width:150px;">
                          ${logoHtml}
                        </td>
                        <td style="vertical-align:middle;text-align:right;">
                          <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.14em;color:#7a6f63;">
                            Central de Agendamentos Prisionais
                          </div>
                          <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#374151;margin-top:4px;">
                            Solicitação de documento/procuração
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <tr>
                  <td style="padding:30px 30px 10px 30px;">
                    <h1 style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:1.25;color:#111827;">
                      Nova solicitação de documento
                    </h1>

                    <p style="margin:10px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#4b5563;">
                      Uma nova solicitação foi registrada pela Central de Agendamentos Prisionais da OAB Juiz de Fora.
                    </p>
                  </td>
                </tr>

                <tr>
                  <td style="padding:18px 30px 8px 30px;">
                    ${montarBlocoHtml('Identificação da solicitação', linhasIdentificacao)}
                  </td>
                </tr>

                <tr>
                  <td style="padding:8px 30px;">
                    ${montarBlocoHtml('Dados do advogado', linhasAdvogado)}
                  </td>
                </tr>

                <tr>
                  <td style="padding:8px 30px 20px 30px;">
                    ${montarBlocoHtml('Dados da pessoa custodiada', linhasIpl)}
                  </td>
                </tr>

                <tr>
                  <td align="center" style="padding:4px 30px 30px 30px;">
                    <a
                      href="${escapeHtml(arquivoUrlEmail)}"
                      style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;padding:13px 22px;border-radius:8px;"
                    >
                      Abrir arquivo enviado
                    </a>

                    <p style="margin:14px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#6b7280;">
                      Caso o botão não funcione, acesse o arquivo pelo painel administrativo da OAB.
                    </p>
                  </td>
                </tr>

                <tr>
                  <td style="padding:20px 30px;background:#f9fafb;border-top:1px solid #eee8dc;">
                    <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.6;color:#4b5563;">
                      A unidade prisional deverá devolver o documento assinado diretamente ao advogado,
                      conforme fluxo definido.
                    </p>

                    <p style="margin:12px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.5;color:#9ca3af;">
                      Este e-mail foi enviado automaticamente pela Central de Agendamentos Prisionais da OAB Juiz de Fora.
                    </p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>
        </table>
      </body>
    </html>
  `;
}

function montarBlocoHtml(titulo, linhas = []) {
  const rowsHtml = linhas
    .map(
      ([label, value]) => `
        <tr>
          <td style="padding:9px 12px;border-bottom:1px solid #f0f0f0;color:#6b7280;width:210px;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
            ${escapeHtml(label)}
          </td>
          <td style="padding:9px 12px;border-bottom:1px solid #f0f0f0;color:#111827;font-weight:700;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
            ${escapeHtml(value)}
          </td>
        </tr>
      `
    )
    .join('');

  return `
    <div style="border:1px solid #ece7dd;border-radius:10px;overflow:hidden;">
      <div style="background:#faf7f1;padding:11px 14px;border-bottom:1px solid #ece7dd;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">
        ${escapeHtml(titulo)}
      </div>

      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background:#ffffff;">
        ${rowsHtml}
      </table>
    </div>
  `;
}

function normalizarArquivoUrlParaEmail(url) {
  const value = text(url);

  if (!value) return '';

  if (/^https?:\/\//i.test(value)) {
    return value;
  }

  if (value.startsWith('wix:image://v1/')) {
    const media = extrairWixMediaParts(value);

    if (media.fileId) {
      return `https://static.wixstatic.com/media/${media.fileId}`;
    }
  }

  if (value.startsWith('wix:document://v1/')) {
    const media = extrairWixMediaParts(value);

    if (media.fileId) {
      const downloadName = media.fileName
        ? `?dn=${encodeURIComponent(media.fileName)}`
        : '';

      return `https://static.wixstatic.com/ugd/${media.fileId}${downloadName}`;
    }
  }

  if (value.startsWith('wix:video://v1/')) {
    const media = extrairWixMediaParts(value);

    if (media.fileId) {
      return `https://video.wixstatic.com/video/${media.fileId}`;
    }
  }

  return value;
}

function extrairWixMediaParts(value) {
  const semHash = text(value).split('#')[0];
  const semPrefixo = semHash.replace(/^wix:[a-z]+:\/\/v1\//i, '');
  const partes = semPrefixo.split('/').filter(Boolean);

  const fileId = partes[0] || '';
  const fileName =
    partes.length > 1 ? decodeURIComponentSafe(partes.slice(1).join('/')) : '';

  return {
    fileId,
    fileName,
  };
}

function decodeURIComponentSafe(value) {
  try {
    return decodeURIComponent(value);
  } catch (err) {
    return value;
  }
}

function isPublicHttpUrl(value) {
  return /^https?:\/\//i.test(text(value));
}

function extrairInfobipMessageId(parsed) {
  try {
    if (!parsed) return '';

    if (parsed.messages && parsed.messages[0] && parsed.messages[0].messageId) {
      return parsed.messages[0].messageId;
    }

    if (parsed.messageId) {
      return parsed.messageId;
    }

    return '';
  } catch (err) {
    return '';
  }
}

function tryParseJson(raw) {
  try {
    return raw ? JSON.parse(raw) : null;
  } catch (err) {
    return null;
  }
}

function normalizarBaseUrl(value) {
  let url = text(value);

  if (!url) return '';

  if (!/^https?:\/\//i.test(url)) {
    url = `https://${url}`;
  }

  return url.replace(/\/+$/, '');
}

function gerarProtocolo(date) {
  const yyyy = date.getFullYear();
  const mm = pad2(date.getMonth() + 1);
  const dd = pad2(date.getDate());
  const hh = pad2(date.getHours());
  const mi = pad2(date.getMinutes());
  const ss = pad2(date.getSeconds());
  const rand = randomToken(4);

  return `DOC-${yyyy}${mm}${dd}-${hh}${mi}${ss}-${rand}`;
}

function randomToken(length) {
  let out = '';
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';

  for (let i = 0; i < length; i += 1) {
    out += chars[Math.floor(Math.random() * chars.length)];
  }

  return out;
}

function pad2(n) {
  return String(n).padStart(2, '0');
}

function text(v) {
  return v === null || v === undefined ? '' : String(v).trim();
}

function digitsOnly(v) {
  return v === null || v === undefined ? '' : String(v).replace(/\D/g, '');
}

function lettersOnly(v) {
  return v === null || v === undefined ? '' : String(v).replace(/[^a-zA-Z]/g, '');
}

function normalizeEmail(v) {
  return text(v).toLowerCase();
}

function isValidEmail(v) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(text(v));
}

function formatPhoneBR(raw) {
  const d = digitsOnly(raw).slice(0, 11);

  if (!d) return '';

  if (d.length <= 2) {
    return `(${d}`;
  }

  const dd = d.slice(0, 2);
  const rest = d.slice(2);

  if (d.length <= 6) {
    return `(${dd}) ${rest}`;
  }

  if (d.length <= 10) {
    return `(${dd}) ${rest.slice(0, 4)}-${rest.slice(4)}`;
  }

  return `(${dd}) ${rest.slice(0, 5)}-${rest.slice(5)}`;
}

function escapeHtml(value) {
  return text(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function escapeMultipartName(value) {
  return text(value).replace(/"/g, '');
}

function limitarTexto(value, max = 500) {
  const v = text(value);

  if (v.length <= max) return v;

  return `${v.slice(0, max)}...`;
}

function normalizarMensagemErro(err) {
  if (!err) return 'Erro desconhecido.';

  if (typeof err === 'string') {
    return limitarTexto(err, 900);
  }

  if (err.message) {
    return limitarTexto(err.message, 900);
  }

  try {
    return limitarTexto(JSON.stringify(err), 900);
  } catch (jsonErr) {
    return 'Erro não identificado.';
  }
}