import wixData from 'wix-data';
import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

const COL = {
  SOLICITACOES_DOCUMENTOS: 'Import4260',
  UNIDADES: 'Import4258',
};

const TIPOS_DOCUMENTO_VALIDOS = ['procuracao', 'documento_complementar', 'outro'];

const INFOBIP_EMAIL_ENDPOINT = '/email/3/send';

export async function confirmarSolicitacaoDocumento(payload = {}) {
  try {
    const dados = normalizarPayload(payload);
    const validacao = validarCamposObrigatorios(dados);

    if (!validacao.ok) {
      return validacao;
    }

    const agora = new Date();
    const protocolo = gerarProtocolo(agora);
    const item = montarItemSolicitacao(dados, protocolo, agora);

    const salvo = await wixData.insert(COL.SOLICITACOES_DOCUMENTOS, item, {
      suppressAuth: true,
    });

    let registroAtual = salvo;
    let emailDestino = dados.unidadeEmailDestino;

    try {
      const destino = await buscarEmailDestinoUnidade(
        dados.unidadeSlug,
        dados.unidadeEmailDestino
      );

      emailDestino = destino.email;

      const envio = await enviarEmailDocumentoParaUnidade({
        dados,
        protocolo,
        emailDestino,
      });

      if (!envio.ok) {
        throw new Error(envio.mensagem || 'Falha no envio pela Infobip.');
      }

      registroAtual = await atualizarSolicitacaoDocumento(salvo, {
        status: 'recebido',
        mensagemErro: '',
        unidadeEmailDestino: emailDestino,
        emailUnidadeEnviado: true,
        emailUnidadeEnviadoEm: new Date(),
      });

      const auditoriaEmailAdvogado = await tentarEnviarEmailDocumentoParaAdvogado({
        dados,
        protocolo,
      });

      registroAtual = await registrarAuditoriaEmailAdvogadoDocumento(
        registroAtual,
        auditoriaEmailAdvogado
      );

      return {
        ok: true,
        protocolo,
        solicitacaoId: salvo._id,
        status: 'recebido',
        emailUnidadeEnviado: true,
        emailAdvogadoEnviado: auditoriaEmailAdvogado.emailAdvogadoEnviado,
        mensagem: 'Solicitação registrada e enviada à unidade prisional.',
      };
    } catch (errEnvio) {
      const mensagemErro = normalizarMensagemErro(errEnvio);

      registroAtual = await atualizarSolicitacaoDocumento(salvo, {
        status: 'com_erro',
        mensagemErro,
        unidadeEmailDestino: emailDestino || '',
        emailUnidadeEnviado: false,
        emailUnidadeEnviadoEm: null,
      });

      const auditoriaEmailAdvogado = await tentarEnviarEmailDocumentoParaAdvogado({
        dados,
        protocolo,
      });

      registroAtual = await registrarAuditoriaEmailAdvogadoDocumento(
        registroAtual,
        auditoriaEmailAdvogado
      );

      return {
        ok: true,
        protocolo,
        solicitacaoId: salvo._id,
        status: 'com_erro',
        emailUnidadeEnviado: false,
        emailAdvogadoEnviado: auditoriaEmailAdvogado.emailAdvogadoEnviado,
        codigo: 'EMAIL_NAO_ENVIADO',
        mensagem:
          'Solicitação registrada, mas houve falha no envio automático para a unidade.',
      };
    }
  } catch (err) {
    console.error('Erro ao confirmar solicitação de documento:', err);

    return {
      ok: false,
      codigo: 'ERRO_INTERNO',
      mensagem:
        'Não foi possível registrar a solicitação agora. Tente novamente em instantes.',
    };
  }
}

function normalizarPayload(payload = {}) {
  const oabUf = lettersOnly(payload.oabUf).toUpperCase().slice(0, 2);
  const oabNumero = digitsOnly(payload.oabNumero);
  const numeroOabInformado = text(payload.numeroOab);
  const numeroOab =
    numeroOabInformado || (oabUf && oabNumero ? `${oabUf}-${oabNumero}` : '');

  const emailAdvogado = normalizeEmail(payload.advEmail || payload.emailAdvogado);
  const tipoDocumento = text(payload.tipoDocumento);
  const tipoDocumentoLabel = text(payload.tipoDocumentoLabel);
  const arquivoPrincipalUrl = text(payload.arquivoPrincipalUrl);
  const arquivoPrincipalNome = text(payload.arquivoPrincipalNome);

  const arquivos = Array.isArray(payload.arquivos) ? payload.arquivos : [];
  const arquivosNormalizados = arquivos
    .map((arquivo) => ({
      url: text(arquivo.url || arquivo.fileUrl),
      nome: text(arquivo.nome || arquivo.name || arquivo.fileName),
    }))
    .filter((arquivo) => arquivo.url);

  const arquivosJson = JSON.stringify(
    arquivosNormalizados.length
      ? arquivosNormalizados
      : [
          {
            url: arquivoPrincipalUrl,
            nome: arquivoPrincipalNome,
          },
        ].filter((arquivo) => arquivo.url)
  );

  return {
    unidadeSlug: text(payload.unidadeSlug),
    unidadeNome: text(payload.unidadeNome),

    nomeAdvogado: text(payload.advNome || payload.nomeAdvogado).replace(/\s+/g, ' '),
    oabUf,
    oabNumero,
    numeroOab,
    emailAdvogado,
    emailIndex: emailAdvogado,
    telefoneAdvogado: digitsOnly(payload.advTelefone || payload.telefoneAdvogado).slice(0, 11),

    nomeIpl: text(payload.nomeIpl).replace(/\s+/g, ' '),
    infopen: digitsOnly(payload.infopen).slice(0, 10),

    tipoDocumento,
    tipoDocumentoLabel,
    arquivoPrincipalUrl,
    arquivoPrincipalNome,
    arquivosJson,
    observacoesAdvogado: text(payload.observacoesAdvogado).replace(/\s+/g, ' '),

    unidadeEmailDestino: normalizeEmail(payload.unidadeEmailDestino),
  };
}

function validarCamposObrigatorios(dados) {
  const erros = [];

  if (!dados.unidadeSlug) erros.push('Unidade prisional não informada.');
  if (!dados.unidadeNome) erros.push('Nome da unidade prisional não informado.');

  if (
    !dados.nomeAdvogado ||
    dados.nomeAdvogado.length < 3 ||
    !dados.nomeAdvogado.includes(' ')
  ) {
    erros.push('Nome completo do advogado inválido.');
  }

  if (!/^[A-Z]{2}-\d{4,}$/.test(dados.numeroOab)) {
    erros.push('OAB inválida.');
  }

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(dados.emailAdvogado)) {
    erros.push('E-mail do advogado inválido.');
  }

  if (![10, 11].includes(dados.telefoneAdvogado.length)) {
    erros.push('Telefone do advogado inválido.');
  }

  if (!dados.nomeIpl || dados.nomeIpl.length < 3) {
    erros.push('Nome da IPL inválido.');
  }

  if (dados.infopen && dados.infopen.length < 5) {
    erros.push('INFOPEN inválido.');
  }

  if (!TIPOS_DOCUMENTO_VALIDOS.includes(dados.tipoDocumento)) {
    erros.push('Tipo de documento inválido.');
  }

  if (!dados.arquivoPrincipalUrl) {
    erros.push('Arquivo do documento não enviado.');
  }

  if (!dados.arquivoPrincipalNome) {
    erros.push('Nome do arquivo não identificado.');
  }

  if (erros.length) {
    return {
      ok: false,
      codigo: 'DADOS_INVALIDOS',
      mensagem: erros.join('\n'),
    };
  }

  return { ok: true };
}

function montarItemSolicitacao(dados, protocolo, agora) {
  const tipoLabel = dados.tipoDocumentoLabel || dados.tipoDocumento;

  return {
    title: `${protocolo} - ${dados.unidadeNome} - ${tipoLabel}`,
    protocolo,

    unidadeSlug: dados.unidadeSlug,
    unidadeNome: dados.unidadeNome,

    nomeAdvogado: dados.nomeAdvogado,
    numeroOab: dados.numeroOab,
    emailAdvogado: dados.emailAdvogado,
    emailIndex: dados.emailIndex,
    telefoneAdvogado: dados.telefoneAdvogado,

    nomeIpl: dados.nomeIpl,
    infopen: dados.infopen,

    tipoDocumento: dados.tipoDocumento,
    arquivoPrincipalUrl: dados.arquivoPrincipalUrl,
    arquivoPrincipalNome: dados.arquivoPrincipalNome,
    arquivosJson: dados.arquivosJson,
    observacoesAdvogado: dados.observacoesAdvogado,

    status: 'recebido',
    mensagemErro: '',
    unidadeEmailDestino: dados.unidadeEmailDestino,
    emailUnidadeEnviado: false,
    emailUnidadeEnviadoEm: null,

    emailAdvogadoEnviado: false,
    emailAdvogadoDestino: dados.emailAdvogado,
    emailAdvogadoErro: '',
    emailAdvogadoEnviadoEm: null,

    criadoEm: agora,
    atualizadoEm: agora,
  };
}

async function atualizarSolicitacaoDocumento(itemSalvo, patch = {}) {
  const atualizado = {
    ...itemSalvo,
    ...patch,
    atualizadoEm: new Date(),
  };

  return wixData.update(COL.SOLICITACOES_DOCUMENTOS, atualizado, {
    suppressAuth: true,
  });
}

async function buscarEmailDestinoUnidade(unidadeSlug, fallbackEmail = '') {
  const fallback = normalizeEmail(fallbackEmail);

  if (isValidEmail(fallback)) {
    return {
      email: fallback,
      origem: 'payload',
    };
  }

  const result = await wixData
    .query(COL.UNIDADES)
    .eq('slug', unidadeSlug)
    .limit(1)
    .find({ suppressAuth: true });

  const unidade = result.items[0];

  if (!unidade) {
    throw new Error(`Unidade não encontrada para o slug: ${unidadeSlug}`);
  }

  const email =
    normalizeEmail(unidade.emailAgenda) ||
    normalizeEmail(unidade.emailDestino) ||
    normalizeEmail(unidade.emailDocumentos);

  if (!isValidEmail(email)) {
    throw new Error(
      `A unidade ${unidade.nome || unidadeSlug} não possui emailAgenda válido.`
    );
  }

  return {
    email,
    origem: 'UnidadesPrisionais.emailAgenda',
    unidade,
  };
}


async function registrarAuditoriaEmailAdvogadoDocumento(itemAtual, auditoria = {}) {
  try {
    return await atualizarSolicitacaoDocumento(itemAtual, auditoria);
  } catch (err) {
    console.warn(
      'Solicitação registrada, mas não foi possível gravar auditoria do e-mail ao advogado.',
      err
    );
    return itemAtual;
  }
}

async function tentarEnviarEmailDocumentoParaAdvogado({ dados, protocolo }) {
  const emailDestino = normalizeEmail(dados.emailAdvogado);

  try {
    const envio = await enviarEmailDocumentoParaAdvogado({
      dados,
      protocolo,
      emailDestino,
    });

    if (!envio.ok) {
      throw new Error(envio.mensagem || 'Falha no envio da confirmação ao advogado.');
    }

    return {
      emailAdvogadoEnviado: true,
      emailAdvogadoDestino: emailDestino,
      emailAdvogadoErro: '',
      emailAdvogadoEnviadoEm: new Date(),
    };
  } catch (err) {
    const mensagemErro = normalizarMensagemErro(err);

    console.warn(
      `Documento ${protocolo} registrado, mas a confirmação ao advogado não foi enviada.`,
      err
    );

    return {
      emailAdvogadoEnviado: false,
      emailAdvogadoDestino: emailDestino,
      emailAdvogadoErro: mensagemErro,
      emailAdvogadoEnviadoEm: null,
    };
  }
}

async function enviarEmailDocumentoParaAdvogado({ dados, protocolo, emailDestino }) {
  const config = await carregarConfigInfobip();
  const assunto = `[OAB/JF] Confirmação de envio de documento - ${protocolo}`;

  const corpoTexto = montarEmailTextoDocumentoAdvogado({
    dados,
    protocolo,
  });

  const corpoHtml = montarEmailHtmlDocumentoAdvogado({
    dados,
    protocolo,
    logoUrl: config.logoUrl,
  });

  return enviarEmailInfobip({
    config,
    to: emailDestino,
    subject: assunto,
    textBody: corpoTexto,
    htmlBody: corpoHtml,
  });
}

function montarEmailTextoDocumentoAdvogado({ dados, protocolo }) {
  const tipoDocumento = dados.tipoDocumentoLabel || dados.tipoDocumento;

  return [
    `Olá, ${dados.nomeAdvogado}.`,
    '',
    'Seu envio de documento/procuração foi registrado pela Central de Agendamentos Prisionais da OAB Juiz de Fora.',
    '',
    `Protocolo: ${protocolo}`,
    `Unidade prisional: ${dados.unidadeNome}`,
    `Tipo de documento: ${tipoDocumento}`,
    `Nome da IPL: ${dados.nomeIpl}`,
    `Arquivo enviado: ${dados.arquivoPrincipalNome}`,
    '',
    'Guarde este protocolo para acompanhamento junto à OAB Juiz de Fora.',
    '',
    'A unidade prisional devolverá o documento assinado diretamente ao advogado, conforme fluxo definido.',
    '',
    'Este é um e-mail automático da Central de Agendamentos Prisionais da OAB Juiz de Fora.',
  ].join('\n');
}

